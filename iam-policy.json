{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndDeleteSQSMessage",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:ap-northeast-1:accountid:IncomingEventsQueue"
    },
    {
      "Sid": "SaveProcessingResults",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:ap-northeast-1:accountid:table/EventProcessingResults"
    }
  ]
}
